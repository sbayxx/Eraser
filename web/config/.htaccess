# Block any public access to the config directory (contains DB credentials).
# The web/ config dir exists on hosts where the FTP user cannot write a sibling
# dir one level above the webroot. Its .htaccess must deny all requests.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
